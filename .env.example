# --- o365Replicator configuration ---
# All of these are optional. They seed the initial config on first run.
# After first run, edit live settings in the web UI (they persist in the DB).

# Where the SQLite database lives (inside the container this is a mounted volume).
DATABASE_URL=sqlite:////data/o365replicator.db

# Default email format used when generating addresses.
# One of: first.last | f.last | first.l | firstlast | flast | first_last | custom
DEFAULT_EMAIL_FORMAT=first.last

# Custom pattern (used only when DEFAULT_EMAIL_FORMAT=custom).
# Tokens: {first} {last} {f} {l} {company} {department}
DEFAULT_EMAIL_CUSTOM_PATTERN={f}{last}

# Fallback domain used when a company has no explicit mapping.
DEFAULT_DOMAIN=demo365.local

# Legacy/static API key still accepted via X-API-Key (in addition to keys minted
# in the UI). Leave blank to rely solely on UI-managed keys / OAuth clients.
API_KEY=

# --- UI login ---
# Optional bootstrap admin. If BOTH are set and no admin exists yet, one is created
# on first startup. If left blank, the first UI visit shows a one-time setup screen.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# How long a UI login stays valid.
SESSION_TTL_HOURS=12
# MUST be true in production behind the Cloudflare tunnel (HTTPS). Set false only
# for local http:// testing, or the login cookie won't be sent.
COOKIE_SECURE=true

# --- OAuth2 (client-credentials) ---
# Lifetime of Bearer access tokens minted at POST /oauth/token.
OAUTH_TOKEN_TTL_SECONDS=3600

# --- Write-back callback to Saviynt (optional; also editable in the UI) ---
CALLBACK_ENABLED=false
CALLBACK_URL=
CALLBACK_METHOD=POST
# Header sent with the callback, e.g. "Authorization: Bearer xyz" -> name|value
CALLBACK_AUTH_HEADER_NAME=
CALLBACK_AUTH_HEADER_VALUE=
